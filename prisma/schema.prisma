generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionTier {
  FREE
  TIER_5
  TIER_10
}

enum MaterialStatus {
  PROCESSING
  READY
  FAILED
}

enum ExamStatus {
  DRAFT
  ACTIVE
  SUBMITTED
  EXPIRED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RoomStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  subscription        Subscription?
  uploadedMaterials   UploadedMaterial[]
  exams               Exam[]
  attempts            Attempt[]
  hostedTestRooms     TestRoom[]            @relation("HostedTestRooms")
  roomParticipations  RoomParticipant[]
  questionBankModules QuestionBankModule[]

  @@map("users")
}

model Subscription {
  id                  String           @id @default(uuid())
  userId              String           @unique
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                SubscriptionTier @default(FREE)
  examsUsedThisPeriod Int              @default(0)
  periodStart         DateTime         @default(now())
  paymentRef          String?

  @@map("subscriptions")
}

model UploadedMaterial {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String?
  fileUrl       String?
  extractedText String?
  status        MaterialStatus @default(PROCESSING)
  createdAt     DateTime       @default(now())

  exams Exam[]

  @@index([userId])
  @@map("uploaded_materials")
}

model Exam {
  id              String           @id @default(uuid())
  materialId      String
  material        UploadedMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  durationMinutes Int
  status          ExamStatus       @default(DRAFT)
  createdAt       DateTime         @default(now())

  questions Question[]
  attempts  Attempt[]
  roomExams RoomExam[]

  @@index([userId])
  @@index([materialId])
  @@map("exams")
}

model Question {
  id                 String     @id @default(uuid())
  examId             String
  exam               Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText       String
  options            Json
  correctOptionIndex Int
  explanation        String?
  diagramSvg         String?
  difficulty         Difficulty @default(MEDIUM)

  @@index([examId])
  @@map("questions")
}

model Attempt {
  id          String    @id @default(uuid())
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId      String?
  room        TestRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomExamId  String?
  roomExam    RoomExam? @relation(fields: [roomExamId], references: [id], onDelete: SetNull)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  answers     Json
  score       Int?

  @@index([examId])
  @@index([userId])
  @@index([roomId])
  @@index([roomExamId])
  @@map("attempts")
}

model TestRoom {
  id          String            @id @default(uuid())
  roomCode    String            @unique
  name        String            @default("NEET Study Circle")
  hostUserId  String
  hostUser    User              @relation("HostedTestRooms", fields: [hostUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  participants RoomParticipant[]
  roomExams    RoomExam[]
  attempts     Attempt[]

  @@index([hostUserId])
  @@index([roomCode])
  @@map("test_rooms")
}

model RoomExam {
  id             String     @id @default(uuid())
  roomId         String
  room           TestRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  examId         String
  exam           Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime   @default(now())
  reminderSentAt DateTime?
  status         RoomStatus @default(SCHEDULED)
  createdAt      DateTime   @default(now())

  attempts Attempt[]

  @@index([roomId])
  @@index([examId])
  @@index([scheduledAt])
  @@map("room_exams")
}

model RoomParticipant {
  id       String   @id @default(uuid())
  roomId   String
  room     TestRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("room_participants")
}

model QuestionBankModule {
  id            String         @id @default(uuid())
  title         String
  description   String
  subject       String
  chapter       String?
  difficulty    Difficulty     @default(MEDIUM)
  isOfficial    Boolean        @default(true)
  creatorUserId String?
  creatorUser   User?          @relation(fields: [creatorUserId], references: [id], onDelete: SetNull)
  sourceExamId  String?
  tags          Json
  createdAt     DateTime       @default(now())

  questions     BankQuestion[]

  @@index([subject])
  @@index([isOfficial])
  @@index([creatorUserId])
  @@map("question_bank_modules")
}

model BankQuestion {
  id                 String             @id @default(uuid())
  moduleId           String
  module             QuestionBankModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questionText       String
  options            Json
  correctOptionIndex Int
  explanation        String?
  diagramSvg         String?
  difficulty         Difficulty         @default(MEDIUM)
  subject            String             @default("Mixed")
  chapter            String?
  topic              String?

  @@index([moduleId])
  @@index([subject])
  @@map("bank_questions")
}
