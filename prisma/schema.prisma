generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionTier {
  FREE
  TIER_5
  TIER_10
}

enum GenerationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MaterialStatus {
  PROCESSING
  READY
  FAILED
}

enum ExamStatus {
  DRAFT
  ACTIVE
  SUBMITTED
  EXPIRED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RoomStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum QuestionAnswerStatus {
  NOT_VISITED
  NOT_ANSWERED
  ANSWERED
  MARKED_FOR_REVIEW
  ANSWERED_AND_MARKED_FOR_REVIEW
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  subscription        Subscription?
  uploadedMaterials   UploadedMaterial[]
  exams               Exam[]
  attempts            Attempt[]
  examAttempts        ExamAttempt[]
  hostedTestRooms     TestRoom[]            @relation("HostedTestRooms")
  roomParticipations  RoomParticipant[]
  questionBankModules QuestionBankModule[]
  examGenerationJobs  ExamGenerationJob[]

  @@map("users")
}

model Subscription {
  id                  String           @id @default(uuid())
  userId              String           @unique
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                SubscriptionTier @default(FREE)
  examsUsedThisPeriod Int              @default(0)
  periodStart         DateTime         @default(now())
  paymentRef          String?

  @@map("subscriptions")
}

model UploadedMaterial {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String?
  fileUrl       String?
  extractedText String?
  status        MaterialStatus @default(PROCESSING)
  createdAt     DateTime       @default(now())

  exams Exam[]

  @@index([userId])
  @@map("uploaded_materials")
}

model Exam {
  id              String           @id @default(uuid())
  materialId      String
  material        UploadedMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  durationMinutes Int
  status          ExamStatus       @default(DRAFT)
  createdAt       DateTime         @default(now())

  questions    Question[]
  attempts     Attempt[]
  examAttempts  ExamAttempt[]
  roomExams     RoomExam[]
  generationJob ExamGenerationJob?

  @@index([userId])
  @@index([materialId])
  @@map("exams")
}

model Question {
  id                 String     @id @default(uuid())
  examId             String
  exam               Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText       String
  options            Json
  correctOptionIndex Int
  explanation        String?
  diagramSvg         String?
  difficulty         Difficulty @default(MEDIUM)

  savedAnswers Answer[]

  @@index([examId])
  @@map("questions")
}

model ExamAttempt {
  id                   String        @id @default(uuid()) @map("attempt_id")
  examId               String        @map("exam_id")
  exam                 Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId               String        @map("user_id")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId               String?       @map("room_id")
  room                 TestRoom?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomExamId           String?       @map("room_exam_id")
  roomExam             RoomExam?     @relation(fields: [roomExamId], references: [id], onDelete: SetNull)
  status               AttemptStatus @default(IN_PROGRESS)
  currentQuestionIndex Int           @default(0) @map("current_question_index")
  startedAt            DateTime      @default(now()) @map("started_at")
  expiresAt            DateTime      @map("expires_at")
  submittedAt          DateTime?     @map("submitted_at")
  score                Int?
  finalizedAttemptId   String?       @unique @map("finalized_attempt_id")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  savedAnswers Answer[]

  @@index([userId, examId], map: "idx_user_exam")
  @@index([userId, examId, status], map: "idx_user_exam_status")
  @@index([userId, startedAt], map: "idx_user_started_at")
  @@index([userId, status], map: "idx_user_status")
  @@index([status, expiresAt], map: "idx_status_expires_at")
  @@index([examId])
  @@index([userId])
  @@index([roomId])
  @@index([roomExamId])
  @@map("exam_attempts")
}

model Answer {
  id                  String               @id @default(uuid()) @map("answer_id")
  attemptId           String               @map("attempt_id")
  attempt             ExamAttempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId          String               @map("question_id")
  question            Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIndex Int?                 @map("selected_option_index")
  status              QuestionAnswerStatus @default(NOT_ANSWERED)
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([attemptId, questionId], map: "idx_attempt_question")
  @@index([questionId], map: "idx_answer_question")
  @@map("answers")
}

model Attempt {
  id          String    @id @default(uuid())
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId      String?
  room        TestRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomExamId  String?
  roomExam    RoomExam? @relation(fields: [roomExamId], references: [id], onDelete: SetNull)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  answers     Json
  score       Int?

  @@index([userId, examId])
  @@index([examId])
  @@index([userId])
  @@index([roomId])
  @@index([roomExamId])
  @@map("attempts")
}

model TestRoom {
  id          String            @id @default(uuid())
  roomCode    String            @unique
  name        String            @default("NEET Study Circle")
  hostUserId  String
  hostUser    User              @relation("HostedTestRooms", fields: [hostUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  participants RoomParticipant[]
  roomExams    RoomExam[]
  attempts     Attempt[]
  examAttempts ExamAttempt[]

  @@index([hostUserId])
  @@index([roomCode])
  @@map("test_rooms")
}

model RoomExam {
  id             String     @id @default(uuid())
  roomId         String
  room           TestRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  examId         String
  exam           Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime   @default(now())
  reminderSentAt DateTime?
  status         RoomStatus @default(SCHEDULED)
  createdAt      DateTime   @default(now())

  attempts     Attempt[]
  examAttempts ExamAttempt[]

  @@index([roomId])
  @@index([examId])
  @@index([scheduledAt])
  @@map("room_exams")
}

model RoomParticipant {
  id       String   @id @default(uuid())
  roomId   String
  room     TestRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("room_participants")
}

model QuestionBankModule {
  id            String         @id @default(uuid())
  title         String
  description   String
  subject       String
  chapter       String?
  difficulty    Difficulty     @default(MEDIUM)
  isOfficial    Boolean        @default(true)
  creatorUserId String?
  creatorUser   User?          @relation(fields: [creatorUserId], references: [id], onDelete: SetNull)
  sourceExamId  String?
  tags          Json
  createdAt     DateTime       @default(now())

  questions     BankQuestion[]

  @@index([subject])
  @@index([isOfficial])
  @@index([creatorUserId])
  @@map("question_bank_modules")
}

model BankQuestion {
  id                 String             @id @default(uuid())
  moduleId           String
  module             QuestionBankModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questionText       String
  options            Json
  correctOptionIndex Int
  explanation        String?
  diagramSvg         String?
  difficulty         Difficulty         @default(MEDIUM)
  subject            String             @default("Mixed")
  chapter            String?
  topic              String?

  @@index([moduleId])
  @@index([subject])
  @@map("bank_questions")
}

model ExamGenerationJob {
  id           String              @id // Client-provided request_id (UUID)
  userId       String              @map("user_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       GenerationJobStatus @default(PENDING)
  examId       String?             @unique @map("exam_id")
  exam         Exam?               @relation(fields: [examId], references: [id], onDelete: SetNull)
  cachedResult Json?               @map("cached_result")
  errorMessage String?             @map("error_message")
  attempts     Int                 @default(0)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("exam_generation_jobs")
}
